menu "Example Configuration"

    config BROKER_URL
        string "Broker URL"
        default "mqtt://mqtt.eclipseprojects.io:1883"
        help
            URL of the broker to connect to

    config BROKER_URL_FROM_STDIN
        bool "Set broker URL from stdin"  # Agregué el texto que aparece en menuconfig
        default n       
    
    config WIFI_SSID
        string "WiFi SSID"
        default "Yosoytuwifi"
        help
            SSID of the WiFi network to connect to
    config WIFI_PASSWORD
        string "WiFi Password"  
        default "Yosoytu1234"
        help    
            Password for the WiFi network
endmenu

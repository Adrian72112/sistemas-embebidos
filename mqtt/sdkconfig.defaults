# WiFi Connection Configuration
CONFIG_WIFI_SSID="YourWiFiSSID"
CONFIG_WIFI_PASSWORD="YourWiFiPassword"
CONFIG_WIFI_CONN_MAX_RETRY=6
CONFIG_WIFI_SCAN_METHOD_ALL_CHANNEL=y
CONFIG_WIFI_SCAN_RSSI_THRESHOLD=-127
CONFIG_WIFI_AUTH_OPEN=y
CONFIG_WIFI_CONNECT_AP_BY_SIGNAL=y
CONFIG_CONNECT_IPV4=y
CONFIG_CONNECT_IPV6=y
CONFIG_CONNECT_IPV6_PREF_LOCAL_LINK=y

# MQTT Configuration
CONFIG_MQTT_BROKER_URL="mqtt://broker.hivemq.com"

# ESP-MQTT Configuration
CONFIG_MQTT_PROTOCOL_5=y
